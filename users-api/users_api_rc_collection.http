# Global variables
@base_url = http://localhost:3000
@userId = 1
@nonExistentUserId = 999


### Test the base URL
GET {{base_url}}


### Retrieve all users
GET {{base_url}}/users


### Retrieve a user by ID
GET {{base_url}}/users/{{userId}}


### Create a new user
#### John Doe
POST {{base_url}}/users
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com"
}

#### Alice Smith
POST {{base_url}}/users
Content-Type: application/json

{
  "name": "Alice Smith",
  "email": "alice.smith@example.com"
}

#### Invalid user (missing email)
POST {{base_url}}/users
Content-Type: application/json

{
  "name": "Bob Johnson",
  "email": "   "
}


### Update a user
#### Valid update for John Doe
PUT {{base_url}}/users/{{userId}}
Content-Type: application/json

{
  "name": "Alice Smith",
  "email": "alice.smith@example.com"
}

#### Invalid update (userId does not exist)
PUT {{base_url}}/users/{{nonExistentUserId}}
Content-Type: application/json

{
  "name": "Non Existent User",
  "email": "nonexistent@example.com"
}


### Delete a user
DELETE {{base_url}}/users/{{userId}}